# === API ===
# Backend API URL. In development, Next.js rewrites /api/* to this automatically.
# Only needed if running the backend on a non-default host/port.
NEXT_PUBLIC_API_URL=http://localhost:8000

# === Sentry (optional) ===
# Frontend error reporting. Leave blank to disable (default for local dev/tests).
NEXT_PUBLIC_SENTRY_DSN=

# === ML explainability dev fixture ===
# Set to true to render /explainability from fixtures/ml-explainability-artifact.json
# without a backend artifact on S3.
NEXT_PUBLIC_ML_EXPLAINABILITY_FIXTURE=
