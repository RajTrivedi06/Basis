# === Database ===
# PostgreSQL connection string. Matches the docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://basis:basis@localhost:5433/basis

# Postgres password used by docker-compose. Local dev keeps the existing
# volume's password ("basis"); production EC2 sets a strong random password
# via `openssl rand -base64 24`.
POSTGRES_PASSWORD=basis

# === Environment ===
# "dev" or "prod". Controls logging verbosity and debug modes.
ENVIRONMENT=dev

# === CORS ===
# Comma-separated origins allowed by the API. Default is local Next.js dev.
# Production EC2 sets this to include the public domain(s).
CORS_ORIGINS=http://localhost:3000

# === Provider API Keys (optional) ===
# Vast.ai: a free key is now effectively REQUIRED. Since 2026-06-23 Vast caps
# unauthenticated responses at 64 cheapest-first offers (dropping the premium
# tier, e.g. H100). Get a free key at https://cloud.vast.ai/ → Account → API Keys.
VAST_API_KEY=

# RunPod: free API key from https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# === AWS (for EC2 Spot price history) ===
# Local dev: paste credentials from a free-tier IAM user with the
# ec2:DescribeSpotPriceHistory permission. boto3 picks them up via the
# default credential chain (load_dotenv populates os.environ at import time).
# Production EC2: leave these blank — boto3 reads from the IAM role attached
# to the instance instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# === Healthchecks.io (production only) ===
# Ping URLs from healthchecks.io. Leave blank locally — the scripts no-op when
# unset, so local dev does not need a healthchecks.io account.
HC_PING_URL=
HC_BACKUP_PING_URL=
HC_DATA_FRESH_PING_URL=
