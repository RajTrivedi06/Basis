# === Database ===
# PostgreSQL connection string. Matches the docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://basis:basis@localhost:5433/basis

# === Environment ===
# "dev" or "prod". Controls logging verbosity and debug modes.
ENVIRONMENT=dev

# === Provider API Keys (optional) ===
# Vast.ai: public API works without a key, but a key gives higher rate limits.
VAST_API_KEY=

# RunPod: free API key from https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# Lambda Labs: free API key from https://cloud.lambda.ai/api-keys
LAMBDA_API_KEY=

# === AWS (for EC2 Spot price history) ===
# Free-tier AWS account credentials. Only needs ec2:DescribeSpotPriceHistory permission.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
